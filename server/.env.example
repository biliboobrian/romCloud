# Port d'écoute du serveur
PORT=8080
# Dossier des données (base SQLite, ROMs, médias scrapés)
DATA_DIR=data
# Dossier des ROMs (relatif à DATA_DIR ou absolu), un sous-dossier par système
ROMS_DIR=roms
# Langue par défaut (fr | en) : journal du serveur et clients sans en-tête Accept-Language
DEFAULT_LANGUAGE=en
# Clé d'API partagée avec l'application Android et l'interface web (fortement conseillé)
API_KEY=

# ScreenScraper.fr — identifiants développeur (demande sur le forum ScreenScraper)
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=
SCREENSCRAPER_SOFTNAME=romcloud
# Compte utilisateur ScreenScraper (facultatif, augmente les quotas)
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
# Préférences de langue / région pour les textes et images
SCRAPE_LANGUAGES=fr,en
SCRAPE_REGIONS=fr,eu,wor,us,ss,jp
