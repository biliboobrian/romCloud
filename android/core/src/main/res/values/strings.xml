    <!-- Guide RetroArch -->
    <string name="ra_not_installed">not installed</string>
    <string name="ra_play_store">Play Store version</string>
    <string name="ra_other_source">installed outside the Play Store</string>
    <string name="ra_step1">Install the right core</string>
    <string name="ra_core_intro">This template uses the core:</string>
    <string name="ra_core_how">In RetroArch: Main Menu → Load Core → Download a Core, then choose this core. The name must match exactly; otherwise, choose another RetroArch template in the emulator list.</string>
    <string name="ra_core_none">This template does not specify a core: RetroArch will use the one associated with this file type.</string>
    <string name="ra_step2">Allow access to the ROMs</string>
    <string name="ra_saf_how">The Play Store version of RetroArch only reads the folders you allow. In RetroArch: Load Content → add a folder, select the RomCloud ROM folder, then “Use this folder” → “Allow”:</string>
    <string name="ra_saf_note">Allow this folder itself, not just a parent folder. RomCloud then passes the ROMs to RetroArch as “saf://” paths.</string>
    <string name="ra_path_how">RetroArch must be able to read RomCloud files: Android Settings → Apps → RetroArch → Permissions → Files → “Allow management of all files”. ROM folder:</string>
    <string name="ra_mode_hint">Mode configurable in the RomCloud Settings → “ROM access for RetroArch”.</string>
    <string name="ra_step3">Close RetroArch before playing</string>
    <string name="ra_close_manual">RetroArch cannot start a game while it is still open in the background (black screen), and since Android 14 RomCloud can no longer close it by itself. Before launching a game, use “Force stop” below if RetroArch has been opened.</string>
    <string name="ra_close_auto">RomCloud closes RetroArch automatically before each launch.</string>
    <string name="ra_quit_on">“Close RetroArch when leaving the game” is enabled: RetroArch closes as soon as you leave it, so the next launch works without any action. Save before leaving a game.</string>
    <string name="ra_quit_off">Tip: enable “Close RetroArch when leaving the game” in the RomCloud Settings so you no longer have to force stop.</string>
    <string name="ra_step4">If the screen stays black</string>
    <string name="ra_log_how">In RetroArch: Settings → Logging → enable “Logging Verbosity” and “Log to File”, launch the game again from RomCloud, then check the log. “Could not read content file” points to a folder access problem (step 2); a core error points to step 1.</string>
