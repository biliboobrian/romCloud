<?xml version="1.0" encoding="utf-8"?>
<!-- Application téléphone / tablette. Autorisations, service et FileProvider : module core. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Catégorie « jeu » : modes jeu d'Android et des constructeurs (performances du moteur intégré).
         isGame (ancien attribut) : encore lu par les lanceurs de jeux de certains constructeurs. -->
    <application
        android:name="com.romcloud.app.RomCloudApp"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.RomCloud"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <!-- Modes de jeu d'Android (performances, économie de batterie) proposés dans le tableau de bord de jeu. -->
        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
